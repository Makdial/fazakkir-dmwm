# Copy this file to `.env` and fill in your own values.

# Cloudflare R2 (https://developers.cloudflare.com/r2/) - S3-compatible storage.
# 1. Create a bucket (e.g. "fazakkir") and enable Public access for it.
# 2. Create an R2 API token with "Object Read & Write" permission to get the
#    access key id / secret access key below.
# 3. Copy your Cloudflare account id and the bucket's public URL.
# The secret access key is server-side only; never expose it in the browser.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=fazakkir
# Optional. Leave empty to use short-lived presigned URLs; set to the bucket's
# Public URL (e.g. https://pub-xxxxxxxx.r2.dev) to serve videos directly.
R2_PUBLIC_BASE_URL=

# --- Email alerts (optional) ----------------------------------------------
# The dashboard emails the administrator before the storage fills up. When
# EMAIL_HOST is empty the messages are printed to the console instead, which
# is handy while developing.
#
# Gmail example (use an "App password", not your normal password):
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=you@gmail.com
#   EMAIL_HOST_PASSWORD=your-app-password
#   EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Fazakkir <no-reply@example.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1

# --- Storage accounting for the dashboard ---------------------------------
# Defaults match the Cloudflare R2 free tier (10 GB) with a 1 GB soft limit for
# the SQLite database and an alert at 90%. Override them here if you have more
# (or less) room.
STORAGE_QUOTA_BYTES=10737418240
DATABASE_QUOTA_BYTES=1073741824
STORAGE_ALERT_THRESHOLD_PERCENT=90
STORAGE_ALERT_EMAIL=makhoutech@gmail.com

# --- Automatic subtitles & translations (optional) -------------------------
# On the video page, staff can transcribe a video's audio and translate it into
# the target languages without uploading any subtitle file. The audio is split
# into chunks, each chunk is transcribed, then every cue is translated and
# stored as a WebVTT track in the database.
#
# Requires an OpenAI API key (https://platform.openai.com/api-keys) and a video
# that already has an MP3 (uploads get one automatically).
SUBTITLE_PROVIDER=openai
OPENAI_API_KEY=
# The language spoken in the videos...
SUBTITLE_SOURCE_LANGUAGE=ar
# ...and the comma-separated languages to translate into.
SUBTITLE_TARGET_LANGUAGES=fr,en
# whisper-1 is the default because it returns per-segment timestamps.
SUBTITLE_TRANSCRIBE_MODEL=whisper-1
SUBTITLE_TRANSLATE_MODEL=gpt-4o-mini
