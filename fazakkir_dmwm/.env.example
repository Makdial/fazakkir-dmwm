# Copy this file to `.env` and fill in your own values.

# --- Production security ---------------------------------------------------
# Signs sessions, cookies and CSRF tokens. Generate a NEW one for every
# deployment (never reuse the development fallback):
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Django refuses to start with DEBUG=0 while SECRET_KEY is the dev fallback.
SECRET_KEY=change-me-generate-a-real-key

# Django only answers to these hostnames, comma separated.
ALLOWED_HOSTS=127.0.0.1,localhost

# Set to 0 in production; the default is 0 already.
DEBUG=1

# Only needed when serving over HTTPS (origin must include the scheme).
CSRF_TRUSTED_ORIGINS=
# Turn on when a proxy/router terminates TLS in front of the app.
USE_X_FORWARDED_PROTO=0
# Only turn these on once the site is HTTPS everywhere.
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=0
# Cookies are marked Secure when DEBUG=0, which is correct for an HTTPS site.
# Set to 0 if the host serves plain HTTP only, otherwise the browser refuses to
# send the session cookie back and every login fails with a 403.
FORCE_HTTPS_COOKIES=1

# --- Database ---------------------------------------------------------------
# Leave empty to use the local SQLite file (fine for development, and for hosts
# with a persistent disk such as PythonAnywhere).
#
# REQUIRED on hosts with an ephemeral filesystem (Render free, most container
# platforms): the SQLite file is deleted on every restart or spin-down, which
# would destroy your accounts, playlists and comments. Point this at a hosted
# Postgres instead - Neon and Supabase both have a permanent free tier:
#   DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=
# How long a background MP3/subtitle job may stay "processing" before it is
# treated as abandoned and marked retryable (hosts that sleep kill the worker).
JOB_STALE_MINUTES=30

# Cloudflare R2 (https://developers.cloudflare.com/r2/) - S3-compatible storage.
# 1. Create a bucket (e.g. "fazakkir") and enable Public access for it.
# 2. Create an R2 API token with "Object Read & Write" permission to get the
#    access key id / secret access key below.
# 3. Copy your Cloudflare account id and the bucket's public URL.
# The secret access key is server-side only; never expose it in the browser.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=fazakkir
# Optional. Leave empty to use short-lived presigned URLs; set to the bucket's
# Public URL (e.g. https://pub-xxxxxxxx.r2.dev) to serve videos directly.
R2_PUBLIC_BASE_URL=

# --- Email alerts (optional) ----------------------------------------------
# The dashboard emails the administrator before the storage fills up. When
# EMAIL_HOST is empty the messages are printed to the console instead, which
# is handy while developing.
#
# Gmail example (use an "App password", not your normal password):
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=you@gmail.com
#   EMAIL_HOST_PASSWORD=your-app-password
#   EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Fazakkir <no-reply@example.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1

# --- Storage accounting for the dashboard ---------------------------------
# Defaults match the Cloudflare R2 free tier (10 GB) with a 1 GB soft limit for
# the SQLite database and an alert at 90%. Override them here if you have more
# (or less) room.
STORAGE_QUOTA_BYTES=10737418240
DATABASE_QUOTA_BYTES=1073741824
STORAGE_ALERT_THRESHOLD_PERCENT=90
STORAGE_ALERT_EMAIL=makhoutech@gmail.com

# --- Automatic subtitles & translations (optional) -------------------------
# On the video page, staff can transcribe a video's audio and translate it into
# the target languages without uploading any subtitle file. The audio is split
# into chunks, each chunk is transcribed, then every cue is translated and
# stored as a WebVTT track in the database.
#
# Pick the back end with SUBTITLE_PROVIDER ("openai", "google" or "elevenlabs")
# and give it an API key. Either way the video needs an MP3 first (uploads get
# one automatically).
SUBTITLE_PROVIDER=openai

# --- OpenAI provider --------------------------------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# whisper-1 is the default because it returns per-segment timestamps.
SUBTITLE_TRANSCRIBE_MODEL=whisper-1
SUBTITLE_TRANSLATE_MODEL=gpt-4o-mini

# --- Google provider --------------------------------------------------------
# One API key drives both Cloud Speech-to-Text and Cloud Translation
# (https://console.cloud.google.com/apis/credentials). Enable both APIs on the
# project that owns the key.
GOOGLE_API_KEY=
# latest_long (continuous speech), latest_short, video…
GOOGLE_SPEECH_MODEL=latest_long
# Exact BCP-47 code for the spoken language, e.g. ar-EG. Empty uses the built-in
# mapping (ar -> ar-SA, fr -> fr-FR, en -> en-US…).
GOOGLE_SPEECH_LANGUAGE=
# Extra language codes to accept alongside the source (comma separated).
GOOGLE_SPEECH_ALTERNATIVE_LANGUAGES=
# Neural Machine Translation (the default) or the legacy "base" model.
GOOGLE_TRANSLATE_MODEL=nmt

# --- ElevenLabs provider ----------------------------------------------------
# Scribe speech-to-text (https://elevenlabs.io/app/settings/api-keys). It
# returns word-level timings, so captions are timed like the other providers.
# ElevenLabs translates audio (dubbing), not text, so this provider produces
# only the source-language track: SUBTITLE_TARGET_LANGUAGES is ignored.
ELEVENLABS_API_KEY=
# scribe_v2 (multilingual) or scribe_v2_medical.
ELEVENLABS_STT_MODEL=scribe_v2
# Force one language for Scribe, or "auto" to let it detect. Empty passes
# SUBTITLE_SOURCE_LANGUAGE through.
ELEVENLABS_LANGUAGE_CODE=

# --- Shared -----------------------------------------------------------------
# The language spoken in the videos...
SUBTITLE_SOURCE_LANGUAGE=ar
# ...and the comma-separated languages to translate into (OpenAI and Google
# only; ElevenLabs keeps the source language alone).
SUBTITLE_TARGET_LANGUAGES=fr,en
